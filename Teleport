local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local TARGET_POSITION = Vector3.new(14992, -55, 938)

local TELEPORT_INTERVAL = 0.1
local JUMP_INTERVAL = 5
local MOVEMENT_INTERVAL = 2

local oldGui = playerGui:FindFirstChild("TeleportGui")
if oldGui then
    oldGui:Destroy()
end

local teleporting = true

local gui = Instance.new("ScreenGui")
gui.Name = "TeleportGui"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 250, 0, 140)
frame.Position = UDim2.new(0.5, -125, 0.5, -70)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -80, 0, 40)
title.Position = UDim2.new(0, 15, 0, 5)
title.BackgroundTransparency = 1
title.Text = "Teleport"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 20
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = frame

local minimize = Instance.new("TextButton")
minimize.Size = UDim2.new(0, 30, 0, 30)
minimize.Position = UDim2.new(1, -70, 0, 10)
minimize.BackgroundTransparency = 1
minimize.Text = "—"
minimize.TextColor3 = Color3.fromRGB(255, 255, 255)
minimize.TextSize = 20
minimize.Font = Enum.Font.GothamBold
minimize.Parent = frame

local close = Instance.new("TextButton")
close.Size = UDim2.new(0, 30, 0, 30)
close.Position = UDim2.new(1, -35, 0, 10)
close.BackgroundTransparency = 1
close.Text = "X"
close.TextColor3 = Color3.fromRGB(255, 80, 80)
close.TextSize = 18
close.Font = Enum.Font.GothamBold
close.Parent = frame

local toggle = Instance.new("TextButton")
toggle.Size = UDim2.new(0, 210, 0, 45)
toggle.Position = UDim2.new(0.5, -105, 0, 55)
toggle.BackgroundColor3 = Color3.fromRGB(60, 180, 75)
toggle.BorderSizePixel = 0
toggle.Text = "Teleport: ON"
toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
toggle.TextSize = 18
toggle.Font = Enum.Font.GothamBold
toggle.Parent = frame

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(0, 8)
toggleCorner.Parent = toggle

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 25)
status.Position = UDim2.new(0, 0, 1, -30)
status.BackgroundTransparency = 1
status.Text = "Teleporting..."
status.TextColor3 = Color3.fromRGB(170, 170, 170)
status.TextSize = 13
status.Font = Enum.Font.Gotham
status.Parent = frame

toggle.MouseButton1Click:Connect(function()
    teleporting = not teleporting

    if teleporting then
        toggle.BackgroundColor3 = Color3.fromRGB(60, 180, 75)
        toggle.Text = "Teleport: ON"
        status.Text = "Teleporting..."
    else
        toggle.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
        toggle.Text = "Teleport: OFF"
        status.Text = "Teleport paused"
    end
end)

close.MouseButton1Click:Connect(function()
    teleporting = false
    gui:Destroy()
end)

local minimized = false

minimize.MouseButton1Click:Connect(function()
    minimized = not minimized

    if minimized then
        frame.Size = UDim2.new(0, 250, 0, 50)
        toggle.Visible = false
        status.Visible = false
        minimize.Text = "+"
    else
        frame.Size = UDim2.new(0, 250, 0, 140)
        toggle.Visible = true
        status.Visible = true
        minimize.Text = "—"
    end
end)

local dragging = false
local dragStart
local startPos

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- Continuous teleport
task.spawn(function()
    while gui.Parent do
        if teleporting then
            local character = player.Character

            if character then
                local root = character:FindFirstChild("HumanoidRootPart")

                if root then
                    root.CFrame = CFrame.new(TARGET_POSITION)
                end
            end
        end

        task.wait(TELEPORT_INTERVAL)
    end
end)

-- Jump every 60 seconds
task.spawn(function()
    while gui.Parent do
        if teleporting then
            local character = player.Character

            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")

                if humanoid and humanoid.Health > 0 then
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    humanoid.Jump = true
                end
            end
        end

        task.wait(JUMP_INTERVAL)
    end
end)

-- Visible automatic movement
task.spawn(function()
    while gui.Parent do
        if teleporting then
            local character = player.Character

            if character then
                local root = character:FindFirstChild("HumanoidRootPart")

                if root then
                    local originalCFrame = root.CFrame

                    root.CFrame = originalCFrame * CFrame.new(3, 0, 0)
                    task.wait(1)

                    root.CFrame = originalCFrame * CFrame.new(-3, 0, 0)
                    task.wait(1)

                    root.CFrame = originalCFrame
                end
            end
        end

        task.wait(MOVEMENT_INTERVAL)
    end
end)
