local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local TARGET_POSITION = Vector3.new(999, -58, 1170)
local TELEPORT_INTERVAL = 0.1
local JUMP_INTERVAL = 2 -- Jump every 60 seconds

-- Remove previous copy if this script is run again
local oldGui = playerGui:FindFirstChild("TeleportGui")
if oldGui then
	oldGui:Destroy()
end

local teleporting = true

--// GUI
local gui = Instance.new("ScreenGui")
gui.Name = "TeleportGui"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Name = "MainFrame"
frame.Size = UDim2.fromOffset(250, 140)
frame.Position = UDim2.new(0.5, -125, 0.2, 0)
frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
frame.BorderSizePixel = 0
frame.Parent = gui

local frameCorner = Instance.new("UICorner")
frameCorner.CornerRadius = UDim.new(0, 8)
frameCorner.Parent = frame

--// Title / Drag Area
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -75, 0, 35)
title.Position = UDim2.fromOffset(10, 5)
title.BackgroundTransparency = 1
title.Text = "Teleport"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 18
title.Font = Enum.Font.SourceSansBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = frame

--// Minimize Button
local minimize = Instance.new("TextButton")
minimize.Size = UDim2.fromOffset(30, 30)
minimize.Position = UDim2.new(1, -70, 0, 5)
minimize.BackgroundTransparency = 1
minimize.Text = "-"
minimize.TextColor3 = Color3.new(1, 1, 1)
minimize.TextSize = 20
minimize.Font = Enum.Font.SourceSansBold
minimize.Parent = frame

--// Close Button
local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(30, 30)
close.Position = UDim2.new(1, -35, 0, 5)
close.BackgroundTransparency = 1
close.Text = "X"
close.TextColor3 = Color3.new(1, 1, 1)
close.TextSize = 18
close.Font = Enum.Font.SourceSansBold
close.Parent = frame

--// Toggle Switch
local toggleFrame = Instance.new("Frame")
toggleFrame.Name = "Toggle"
toggleFrame.Size = UDim2.fromOffset(55, 30)
toggleFrame.Position = UDim2.fromOffset(20, 52)
toggleFrame.BackgroundColor3 = Color3.fromRGB(70, 170, 90)
toggleFrame.BorderSizePixel = 0
toggleFrame.Parent = frame

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(1, 0)
toggleCorner.Parent = toggleFrame

local knob = Instance.new("Frame")
knob.Name = "Knob"
knob.Size = UDim2.fromOffset(24, 24)
knob.Position = UDim2.fromOffset(28, 3)
knob.BackgroundColor3 = Color3.new(1, 1, 1)
knob.BorderSizePixel = 0
knob.Parent = toggleFrame

local knobCorner = Instance.new("UICorner")
knobCorner.CornerRadius = UDim.new(1, 0)
knobCorner.Parent = knob

local toggleClick = Instance.new("TextButton")
toggleClick.Size = UDim2.fromScale(1, 1)
toggleClick.BackgroundTransparency = 1
toggleClick.Text = ""
toggleClick.Parent = toggleFrame

local toggleLabel = Instance.new("TextLabel")
toggleLabel.Size = UDim2.fromOffset(150, 30)
toggleLabel.Position = UDim2.fromOffset(65, 0)
toggleLabel.BackgroundTransparency = 1
toggleLabel.Text = "Teleport: ON"
toggleLabel.TextColor3 = Color3.new(1, 1, 1)
toggleLabel.TextSize = 16
toggleLabel.Font = Enum.Font.SourceSans
toggleLabel.TextXAlignment = Enum.TextXAlignment.Left
toggleLabel.Parent = toggleFrame

--// Status
local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 30)
status.Position = UDim2.fromOffset(10, 95)
status.BackgroundTransparency = 1
status.Text = "Teleporting..."
status.TextColor3 = Color3.fromRGB(100, 255, 100)
status.TextSize = 15
status.Font = Enum.Font.SourceSans
status.Parent = frame

--// Toggle Function
toggleClick.MouseButton1Click:Connect(function()
	teleporting = not teleporting

	if teleporting then
		toggleFrame.BackgroundColor3 = Color3.fromRGB(70, 170, 90)
		knob.Position = UDim2.fromOffset(28, 3)
		toggleLabel.Text = "Teleport: ON"
		status.Text = "Teleporting..."
		status.TextColor3 = Color3.fromRGB(100, 255, 100)
	else
		toggleFrame.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
		knob.Position = UDim2.fromOffset(3, 3)
		toggleLabel.Text = "Teleport: OFF"
		status.Text = "Teleport paused"
		status.TextColor3 = Color3.fromRGB(255, 100, 100)
	end
end)

--// Close
close.MouseButton1Click:Connect(function()
	teleporting = false
	gui:Destroy()
end)

--// Minimize
local minimized = false

minimize.MouseButton1Click:Connect(function()
	minimized = not minimized

	toggleFrame.Visible = not minimized
	status.Visible = not minimized

	if minimized then
		frame.Size = UDim2.fromOffset(250, 40)
		minimize.Text = "+"
	else
		frame.Size = UDim2.fromOffset(250, 140)
		minimize.Text = "-"
	end
end)

--// Draggable
local dragging = false
local dragStart
local startPosition

title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = frame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart

		frame.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

--// Continuous Teleport
task.spawn(function()
	while gui.Parent do
		if teleporting then
			local character = player.Character

			if character then
				local root = character:FindFirstChild("HumanoidRootPart")

				if root then
					root.CFrame = CFrame.new(TARGET_POSITION)
				end
			end
		end

		task.wait(TELEPORT_INTERVAL)
	end
end)

--// Jump immediately, then every 60 seconds
task.spawn(function()
	while gui.Parent do
		if teleporting then
			local character = player.Character

			if character then
				local humanoid = character:FindFirstChildOfClass("Humanoid")

				if humanoid and humanoid.Health > 0 then
					humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
					humanoid.Jump = true
				end
			end
		end

		task.wait(JUMP_INTERVAL)
	end
end)
